// DealFlow360 - Complete B2B Quote-to-Cash Relational Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SALES_REP
  SALES_MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum QuotationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT_TO_CUSTOMER
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

// -------------------------------------------------------------
// USER & CUSTOMER ACCOUNTS
// -------------------------------------------------------------

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role      @default(SALES_REP)
  phone        String?
  isActive     Boolean   @default(true)
  
  // Link to customer account if user is external customer
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Relations
  createdQuotations Quotation[]       @relation("CreatedByUser")
  assignedQuotations Quotation[]      @relation("AssignedToUser")
  approvalRequests  ApprovalRequest[] @relation("RequestedByUser")
  reviewedApprovals ApprovalRequest[] @relation("ReviewedByUser")
  auditLogs         AuditLog[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([role])
}

model Customer {
  id           String      @id @default(uuid())
  name         String
  companyName  String
  email        String      @unique
  phone        String?
  taxId        String?
  address      String?
  city         String?
  state        String?
  postalCode   String?
  country      String      @default("USA")
  creditLimit  Decimal     @default(50000.00) @db.Decimal(12, 2)
  paymentTerms String      @default("Net 30")
  status       String      @default("ACTIVE")

  users        User[]
  contacts     Contact[]
  quotations   Quotation[]
  orders       SalesOrder[]
  invoices     Invoice[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyName])
}

model Contact {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  firstName  String
  lastName   String
  email      String
  phone      String?
  title      String?
  isPrimary  Boolean  @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([customerId])
}

// -------------------------------------------------------------
// PRODUCTS, CATALOG & PRICEBOOKS
// -------------------------------------------------------------

model ProductCategory {
  id          String            @id @default(uuid())
  name        String            @unique
  slug        String            @unique
  description String?
  parentId    String?
  parent      ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    ProductCategory[] @relation("CategoryHierarchy")
  products    Product[]

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Product {
  id              String             @id @default(uuid())
  sku             String             @unique
  name            String
  description     String?
  categoryId      String?
  category        ProductCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  basePrice       Decimal            @db.Decimal(12, 2)
  costPrice       Decimal            @db.Decimal(12, 2)
  currency        String             @default("USD")
  unitOfMeasure   String             @default("UNIT")
  isConfigurable  Boolean            @default(false)
  isActive        Boolean            @default(true)
  inventoryCount  Int                @default(100)

  priceBookEntries PriceBookEntry[]
  quoteLineItems   QuotationLineItem[]
  orderLineItems   SalesOrderLineItem[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([sku])
  @@index([name])
}

model PriceBook {
  id          String           @id @default(uuid())
  name        String
  description String?
  currency    String           @default("USD")
  validFrom   DateTime?
  validTo     DateTime?
  isActive    Boolean          @default(true)
  isDefault   Boolean          @default(false)

  entries     PriceBookEntry[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model PriceBookEntry {
  id          String    @id @default(uuid())
  priceBookId String
  priceBook   PriceBook @relation(fields: [priceBookId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  unitPrice   Decimal   @db.Decimal(12, 2)
  minQuantity Int       @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([priceBookId, productId])
}

// -------------------------------------------------------------
// QUOTATIONS & APPROVAL MATRIX
// -------------------------------------------------------------

model Quotation {
  id                 String              @id @default(uuid())
  quotationNumber    String              @unique
  version            Int                 @default(1)
  
  customerId         String
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  createdById        String
  createdBy          User                @relation("CreatedByUser", fields: [createdById], references: [id], onDelete: Restrict)
  
  assignedToId       String?
  assignedTo         User?               @relation("AssignedToUser", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  status             QuotationStatus     @default(DRAFT)
  
  // Financial Totals
  currency           String              @default("USD")
  totalListAmount    Decimal             @default(0.00) @db.Decimal(12, 2)
  discountPercent    Decimal             @default(0.00) @db.Decimal(5, 2)
  discountAmount     Decimal             @default(0.00) @db.Decimal(12, 2)
  totalNetAmount     Decimal             @default(0.00) @db.Decimal(12, 2)
  taxAmount          Decimal             @default(0.00) @db.Decimal(12, 2)
  totalGrossAmount   Decimal             @default(0.00) @db.Decimal(12, 2)
  
  notes              String?
  termsAndConditions String?
  validUntil         DateTime?
  approvalScore      Int                 @default(100)
  
  submittedAt        DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  
  lineItems          QuotationLineItem[]
  approvalRequests   ApprovalRequest[]
  salesOrders        SalesOrder[]

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([quotationNumber])
  @@index([customerId])
  @@index([status])
}

model QuotationLineItem {
  id              String    @id @default(uuid())
  quotationId     String
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  
  itemDescription String?
  quantity        Int       @default(1)
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0.00) @db.Decimal(5, 2)
  discountAmount  Decimal   @default(0.00) @db.Decimal(12, 2)
  netPrice        Decimal   @db.Decimal(12, 2)
  subtotal        Decimal   @db.Decimal(12, 2)
  lineOrder       Int       @default(0)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([quotationId])
}

model ApprovalRule {
  id                 String   @id @default(uuid())
  name               String
  minDiscountPercent Decimal  @db.Decimal(5, 2)
  maxDiscountPercent Decimal  @db.Decimal(5, 2)
  requiredRole       Role     @default(SALES_MANAGER)
  minAmount          Decimal? @db.Decimal(12, 2)
  maxAmount          Decimal? @db.Decimal(12, 2)
  isActive           Boolean  @default(true)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  quotationId   String
  quotation     Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  requestedById String
  requestedBy   User           @relation("RequestedByUser", fields: [requestedById], references: [id], onDelete: Restrict)
  
  reviewedById  String?
  reviewedBy    User?          @relation("ReviewedByUser", fields: [reviewedById], references: [id], onDelete: SetNull)
  
  status        ApprovalStatus @default(PENDING)
  justification String?
  reviewNotes   String?
  
  requestedAt   DateTime       @default(now())
  reviewedAt    DateTime?

  @@index([quotationId])
  @@index([status])
}

// -------------------------------------------------------------
// ORDERS & INVOICES
// -------------------------------------------------------------

model SalesOrder {
  id          String               @id @default(uuid())
  orderNumber String               @unique
  quotationId String?
  quotation   Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  
  customerId  String
  customer    Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  totalAmount Decimal              @db.Decimal(12, 2)
  currency    String               @default("USD")
  status      OrderStatus          @default(PENDING)

  lineItems   SalesOrderLineItem[]
  invoices    Invoice[]

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([orderNumber])
  @@index([customerId])
}

model SalesOrderLineItem {
  id          String     @id @default(uuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  unitPrice   Decimal    @db.Decimal(12, 2)
  subtotal    Decimal    @db.Decimal(12, 2)

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orderId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String?
  order         SalesOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  
  totalAmount   Decimal       @db.Decimal(12, 2)
  paidAmount    Decimal       @default(0.00) @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  issuedAt      DateTime?
  paidAt        DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([invoiceNumber])
  @@index([customerId])
}

// -------------------------------------------------------------
// AUDIT & GOVERNANCE LOGGING
// -------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  entityName    String
  entityId      String
  previousState Json?
  newState      Json?
  ipAddress     String?
  userAgent     String?
  requestId     String?
  timestamp     DateTime @default(now())

  @@index([entityName, entityId])
  @@index([userId])
}
