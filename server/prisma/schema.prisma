// DealFlow360 - Complete Forward-Compatible B2B Quote-to-Cash Relational Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  SALES_REP
  SALES_MANAGER
  FINANCE
  ADMIN
  CUSTOMER
}

enum UserStatus {
  INVITATION_PENDING
  ACTIVE
  DEACTIVATED
}

enum InvitationType {
  INTERNAL_USER
  CUSTOMER_PORTAL
}

enum CustomerTier {
  BRONZE
  SILVER
  GOLD
}

enum QuotationStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SENT_TO_CUSTOMER
  CUSTOMER_ACCEPTED
  CUSTOMER_REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

// -------------------------------------------------------------
// USER & CUSTOMER ACCOUNTS
// -------------------------------------------------------------

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String?
  role         Role          @default(SALES_REP)
  status       UserStatus    @default(INVITATION_PENDING)
  customerTier CustomerTier? // nullable for customer users

  customerId   String?
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Relations
  ownedQuotations      Quotation[]    @relation("QuotationOwner")
  approvalSteps        ApprovalStep[]
  auditLogsAsActor     AuditLog[]     @relation("AuditActor")
  invitationsCreated   Invitation[]   @relation("InvitedBy")

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model Customer {
  id           String        @id @default(uuid())
  name         String
  tier         CustomerTier  @default(BRONZE)
  email        String        @unique
  portalUserId String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  users        User[]
  quotations   Quotation[]
  invitations  Invitation[]

  @@index([email])
  @@index([tier])
  @@index([createdAt])
}

// -------------------------------------------------------------
// INVITATIONS
// -------------------------------------------------------------

model Invitation {
  id           String         @id @default(uuid())
  email        String
  role         Role
  type         InvitationType
  tokenHash    String         @unique   // SHA-256 hash of raw token
  invitedById  String
  invitedBy    User           @relation("InvitedBy", fields: [invitedById], references: [id])
  customerId   String?
  customer     Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  acceptedAt   DateTime?
  isUsed       Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([email])
  @@index([tokenHash])
  @@index([isUsed])
  @@index([expiresAt])
}

// -------------------------------------------------------------
// AUDIT LOG
// -------------------------------------------------------------

model AuditLog {
  id           String     @id @default(uuid())
  actorId      String
  actor        User       @relation("AuditActor", fields: [actorId], references: [id])
  action       String     // CREATED_USER, DEACTIVATED_USER, CHANGED_ROLE, ACCEPTED_INVITATION, etc.
  targetId     String?    // uuid of affected record
  targetType   String?    // User, Customer, Invitation, Quotation
  quotationId  String?
  quotation    Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  reasonNote   String?
  beforeStatus String?
  afterStatus  String?
  meta         Json?
  createdAt    DateTime   @default(now())

  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@index([quotationId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// PRODUCTS, VARIANTS & CATALOG
// -------------------------------------------------------------

model Product {
  id                  String           @id @default(uuid())
  name                String
  sku                 String           @unique
  category            String
  basePrice           Decimal          @db.Decimal(12, 2)
  baseCost            Decimal          @db.Decimal(12, 2)
  unit                String           @default("UNIT")
  taxPercent          Decimal          @default(0.00) @db.Decimal(5, 2)
  description         String?
  isRecurringEligible Boolean          @default(false)
  isActive            Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  variants            ProductVariant[]
  priceListItems      PriceListItem[]
  stockLevels         StockLevel[]
  quotationLines      QuotationLine[]
  fulfillmentSplits   FulfillmentSplit[]
  triggerUpsells      UpsellRule[]     @relation("TriggerProduct")
  suggestedUpsells    UpsellRule[]     @relation("SuggestedProduct")

  @@index([sku])
  @@index([category])
  @@index([isActive])
  @@index([createdAt])
}

model ProductVariant {
  id             String          @id @default(uuid())
  productId      String
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeName  String
  attributeValue String
  extraPrice     Decimal         @default(0.00) @db.Decimal(12, 2)
  skuSuffix      String
  isActive       Boolean         @default(true)

  priceListItems PriceListItem[]
  quotationLines QuotationLine[]

  @@index([productId])
}

// -------------------------------------------------------------
// PRICING RULES & DISCOUNT CEILINGS
// -------------------------------------------------------------

model PriceList {
  id           String          @id @default(uuid())
  name         String
  customerTier CustomerTier
  currency     String          @default("USD")
  pricingRule  String?
  isActive     Boolean         @default(true)
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  items        PriceListItem[]

  @@index([customerTier])
  @@index([isActive])
}

model PriceListItem {
  id              String          @id @default(uuid())
  priceListId     String
  priceList       PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unitPrice       Decimal         @db.Decimal(12, 2)
  minimumQuantity Int             @default(1)
  effectiveFrom   DateTime?
  effectiveTo     DateTime?

  @@index([priceListId])
  @@index([productId])
}

model DiscountTier {
  id                 String       @id @default(uuid())
  customerTier       CustomerTier @unique
  maxDiscountPercent Decimal      @db.Decimal(5, 2)
  isActive           Boolean      @default(true)

  @@index([customerTier])
}

model CategoryDiscountCeiling {
  id                 String   @id @default(uuid())
  category           String   @unique
  maxDiscountPercent Decimal  @db.Decimal(5, 2)
  isActive           Boolean  @default(true)

  @@index([category])
}

model ApprovalChainRule {
  id             String   @id @default(uuid())
  minimumOverage Decimal  @db.Decimal(5, 2)
  maximumOverage Decimal  @db.Decimal(5, 2)
  requiredRole   Role
  orderIndex     Int      @default(1)
  isActive       Boolean  @default(true)

  @@index([requiredRole])
}

// -------------------------------------------------------------
// WAREHOUSES & INVENTORY
// -------------------------------------------------------------

model Warehouse {
  id                 String             @id @default(uuid())
  name               String             @unique
  location           String
  shippingCostWeight Decimal            @default(1.00) @db.Decimal(6, 2)
  isActive           Boolean            @default(true)

  stockLevels        StockLevel[]
  fulfillmentSplits  FulfillmentSplit[]

  @@index([name])
}

model StockLevel {
  id                     String    @id @default(uuid())
  warehouseId            String
  warehouse              Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productId              String
  product                Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityOnHand         Int       @default(0)
  reserved               Int       @default(0)
  replenishmentThreshold Int       @default(10)

  @@unique([warehouseId, productId])
  @@index([warehouseId])
  @@index([productId])
}

// -------------------------------------------------------------
// SUBSCRIPTIONS
// -------------------------------------------------------------

model SubscriptionPlan {
  id               String            @id @default(uuid())
  name             String
  billingCycle     BillingCycle
  price            Decimal           @db.Decimal(12, 2)
  prorationRule    String?
  cancellationRule String?
  isActive         Boolean           @default(true)

  quotationLines   QuotationLine[]
  billingSchedules BillingSchedule[]

  @@index([billingCycle])
  @@index([isActive])
}

// -------------------------------------------------------------
// QUOTATIONS & LINES
// -------------------------------------------------------------

model Quotation {
  id               String            @id @default(uuid())
  quoteNumber      String            @unique
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  ownerRepId       String
  ownerRep         User              @relation("QuotationOwner", fields: [ownerRepId], references: [id], onDelete: Restrict)
  currency         String            @default("USD")
  status           QuotationStatus   @default(DRAFT)
  subtotal         Decimal           @default(0.00) @db.Decimal(12, 2)
  discountTotal    Decimal           @default(0.00) @db.Decimal(12, 2)
  taxTotal         Decimal           @default(0.00) @db.Decimal(12, 2)
  grandTotal       Decimal           @default(0.00) @db.Decimal(12, 2)
  totalCost        Decimal           @default(0.00) @db.Decimal(12, 2)
  marginAmount     Decimal           @default(0.00) @db.Decimal(12, 2)
  marginPercentage Decimal           @default(0.00) @db.Decimal(5, 2)
  blendedRiskScore Int               @default(0)
  riskLevel        RiskLevel         @default(LOW)
  version          Int               @default(1)
  expirationDate   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  lines            QuotationLine[]
  approvalSteps    ApprovalStep[]
  auditLogs        AuditLog[]
  fulfillmentSplits FulfillmentSplit[]
  invoices         Invoice[]
  dealHealthFlags  DealHealthFlag[]

  @@index([quoteNumber])
  @@index([status])
  @@index([customerId])
  @@index([ownerRepId])
  @@index([createdAt])
}

model QuotationLine {
  id                  String            @id @default(uuid())
  quotationId         String
  quotation           Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId           String
  product             Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId           String?
  variant             ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity            Int               @default(1)
  unitPrice           Decimal           @db.Decimal(12, 2)
  unitCost            Decimal           @db.Decimal(12, 2)
  discountPercent     Decimal           @default(0.00) @db.Decimal(5, 2)
  lineDiscountLimit   Decimal           @default(0.00) @db.Decimal(5, 2)
  taxPercent          Decimal           @default(0.00) @db.Decimal(5, 2)
  lineSubtotal        Decimal           @db.Decimal(12, 2)
  lineDiscountAmount  Decimal           @default(0.00) @db.Decimal(12, 2)
  lineMargin          Decimal           @db.Decimal(12, 2)
  isRecurring         Boolean           @default(false)
  subscriptionPlanId  String?
  subscriptionPlan    SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  categorySnapshot    String
  productNameSnapshot String

  billingSchedules    BillingSchedule[]

  @@index([quotationId])
  @@index([productId])
}

// -------------------------------------------------------------
// APPROVALS, AUDIT & FULFILLMENT
// -------------------------------------------------------------

model ApprovalStep {
  id             String         @id @default(uuid())
  quotationId    String
  quotation      Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  stepOrder      Int
  requiredRole   Role
  assignedUserId String?
  assignedUser   User?          @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  status         ApprovalStatus @default(PENDING)
  actionedAt     DateTime?
  notes          String?
  createdAt      DateTime       @default(now())

  @@index([quotationId])
  @@index([status])
}



model FulfillmentSplit {
  id                String    @id @default(uuid())
  quotationId       String
  quotation         Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantityFulfilled Int
  backorderQuantity Int       @default(0)
  estimatedCost     Decimal   @db.Decimal(12, 2)
  status            String    @default("ALLOCATED")

  @@index([quotationId])
  @@index([warehouseId])
  @@index([productId])
}

// -------------------------------------------------------------
// INVOICES & BILLING SCHEDULES
// -------------------------------------------------------------

model Invoice {
  id            String        @id @default(uuid())
  quotationId   String
  quotation     Quotation     @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  invoiceNumber String        @unique
  type          String        @default("STANDARD")
  amount        Decimal       @db.Decimal(12, 2)
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime
  paidAt        DateTime?

  @@index([invoiceNumber])
  @@index([quotationId])
  @@index([status])
}

model BillingSchedule {
  id                 String            @id @default(uuid())
  subscriptionPlanId String?
  subscriptionPlan   SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id], onDelete: SetNull)
  quotationLineId    String?
  quotationLine      QuotationLine?    @relation(fields: [quotationLineId], references: [id], onDelete: SetNull)
  nextBillDate       DateTime
  amount             Decimal           @db.Decimal(12, 2)
  status             String            @default("SCHEDULED")

  @@index([nextBillDate])
  @@index([status])
}

// -------------------------------------------------------------
// UPSELL RULES & DEAL HEALTH FLAGS
// -------------------------------------------------------------

model UpsellRule {
  id                     String   @id @default(uuid())
  triggerProductId       String
  triggerProduct         Product  @relation("TriggerProduct", fields: [triggerProductId], references: [id], onDelete: Cascade)
  suggestedProductId     String
  suggestedProduct       Product  @relation("SuggestedProduct", fields: [suggestedProductId], references: [id], onDelete: Cascade)
  minimumMarginThreshold Decimal  @db.Decimal(5, 2)
  isPromoted             Boolean  @default(false)
  isActive               Boolean  @default(true)

  @@index([triggerProductId])
  @@index([suggestedProductId])
}

model DealHealthFlag {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  flagType    String
  details     String
  severity    String    @default("MEDIUM")
  isResolved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([quotationId])
  @@index([isResolved])
}
